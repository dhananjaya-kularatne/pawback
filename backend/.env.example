# Reference only: Spring reads process environment, not this file automatically.
DB_URL=jdbc:mysql://localhost:3306/pawback?createDatabaseIfNotExist=true
DB_USERNAME=root
DB_PASSWORD=
JWT_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FRONTEND_URL=http://localhost:5173
BACKEND_PUBLIC_URL=http://localhost:8080
OAUTH_REDIRECT_URI=http://localhost:5173/oauth2/redirect
CORS_ALLOWED_ORIGINS=http://localhost:5173
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
# Existing Hibernate-era databases only, after backup and schema review:
FLYWAY_BASELINE_ON_MIGRATE=false
# Production also requires migration credentials with schema-changing privileges.
DB_MIGRATION_USERNAME=
DB_MIGRATION_PASSWORD=
# Trust only your actual edge proxy peer address; the edge must replace X-Forwarded-For.
TRUSTED_PROXY_IPS=
